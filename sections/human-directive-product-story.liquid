{{ 'section-human-directive-product.css' | asset_url | stylesheet_tag }}

<section class="human-directive-story">
  <div class="page-width human-directive-story__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="human-directive-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    <h2 class="human-directive-story__heading">{{ section.settings.heading | escape }}</h2>
    {% if section.settings.intro != blank %}
      <div class="human-directive-story__intro rte">{{ section.settings.intro }}</div>
    {% endif %}

    <div class="human-directive-story__benefits">
      {% for block in section.blocks %}
        {% if block.type == 'benefit' %}
          <article class="human-directive-story__benefit" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    <div class="human-directive-story__grid">
      <div class="human-directive-story__media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1200, 1400', loading: 'lazy' }}
        {% elsif product.featured_media != blank %}
          {{ product.featured_media.preview_image | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1200, 1400', loading: 'lazy' }}
        {% else %}
          <div class="human-directive-story__placeholder">Add a product or ingredient image in the Theme Editor.</div>
        {% endif %}
      </div>

      <div class="human-directive-story__list">
        {% for block in section.blocks %}
          {% if block.type == 'ingredient' %}
            <article class="human-directive-story__card" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.name | escape }}</h3>
              <p>{{ block.settings.description | escape }}</p>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="human-directive-story__routine">
      <h2>{{ section.settings.routine_heading | escape }}</h2>
      <ol class="human-directive-story__steps">
        {% assign step_number = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'step' %}
            {% assign step_number = step_number | plus: 1 %}
            <li {{ block.shopify_attributes }}>
              <span class="human-directive-story__step-number">{{ step_number }}</span>
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ block.settings.text | escape }}</p>
            </li>
          {% endif %}
        {% endfor %}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HD product story",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE FORMULA" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thoughtfully made for your daily oral routine." },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Four complementary ingredients in one easy daily chewable.</p>" },
    { "type": "image_picker", "id": "image", "label": "Formula image" },
    { "type": "text", "id": "routine_heading", "label": "Routine heading", "default": "A simple three-step habit." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A concise, product-approved benefit." }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Ingredient name" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "A concise, product-approved description." }
      ]
    },
    {
      "type": "step",
      "name": "Routine step",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A short instruction." }
      ]
    }
  ],
  "presets": [
    { "name": "HD product story" }
  ]
}
{% endschema %}
